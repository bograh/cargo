# Cargo deployment configuration.
#
# Copy this file to `.env`, fill in the values, then:
#   chmod 600 .env
#   docker network create cargo-proxy   # shared app/proxy network (once)
#   docker compose up -d
#
# `./install.sh` generates this file for you (with fresh secrets) — edit it by
# hand only if you're setting up manually. The first account you register
# becomes the instance admin.
#
# ── Do NOT commit your real .env ── it holds secrets and is gitignored.

# ─────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────

# Encryption key for secrets at rest (env vars, DB credentials, tokens).
# MUST be 64 hex characters (32 bytes). Generate one with:
#   openssl rand -hex 32
# ⚠️  Back this up somewhere safe. Losing it makes stored secrets unrecoverable.
CARGO_MASTER_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32

# Password for the bundled PostgreSQL container (also used in CARGO_DATABASE_URL,
# which docker-compose.yml builds automatically). Generate one with:
#   openssl rand -hex 16
CARGO_DB_PASSWORD=replace-with-a-strong-password

# ─────────────────────────────────────────────────────────────────────────
# Domains
# ─────────────────────────────────────────────────────────────────────────

# Where the Cargo UI is served.
#   - Local install: leave empty (also reachable on localhost / the server IP).
#   - Production: your platform host, e.g. cargo.example.com
CARGO_PLATFORM_DOMAIN=

# Suffix for deployed app URLs — apps are served at <app-name>.<suffix>.
#   - Local install: apps.localhost
#   - Production: e.g. apps.example.com  (needs a *.apps.example.com DNS record)
CARGO_APPS_SUFFIX=apps.localhost

# ─────────────────────────────────────────────────────────────────────────
# TLS / Let's Encrypt (production only — leave blank for a local install)
# ─────────────────────────────────────────────────────────────────────────

# Email used for Let's Encrypt certificate registration.
# Required when running with a TLS overlay (docker-compose.tls.yml / .dns01.yml).
CARGO_ACME_EMAIL=

# Wildcard certs via DNS-01. A Traefik DNS provider name (e.g. cloudflare, route53).
# Leave empty to use per-domain HTTP-01 instead. Only used with docker-compose.dns01.yml.
# See: https://doc.traefik.io/traefik/https/acme/#providers
CARGO_DNS_PROVIDER=

# DNS provider credentials for DNS-01 (only the ones your provider needs).
# Cloudflare:
CF_DNS_API_TOKEN=
# AWS Route53:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ─────────────────────────────────────────────────────────────────────────
# Development (only used by docker-compose.dev.yml)
# ─────────────────────────────────────────────────────────────────────────

# Host port to publish the control plane on when using the dev overlay.
CARGO_DEV_PORT=8080
